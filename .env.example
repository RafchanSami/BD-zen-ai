# OPENROUTER_API_KEY: Primary key for OpenRouter models.
OPENROUTER_API_KEY=""

# GROQ_API_KEY: High-speed fallback API key for Groq Cloud.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

